# Dependencies
node_modules/
tests/e2e/node_modules/

# Test artifacts
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/test-results/
tests/playwright-report/
tests/.cov-server.json

# Environment
.env
.env.testing
!.env.example
!tests/.env.testing.example

# Keep storage tracked, but exclude sensitive runtime keys.
storage/keys/app.key
storage/keys/app_token.key

# Runtime uploads: never commit user/test uploaded files, keep folder placeholders.
storage/uploads/**
!storage/uploads/.gitkeep
!storage/uploads/news/.gitkeep

# Agent / tool scratch directories (local workflow state, never committed)
.agent/
.omo/
.codegraph/

# Logs & local scratch (generated by tooling/agents; never commit)
*.log
_*.ps1
_*.php
_tiny*

# Exception: archived pentest evidence keeps its raw Strix run traces on purpose,
# so each finding can be traced back to the exact agent steps that produced it.
!docs/intern/strix-runs*/**/strix.log

# SQLite sidecar/temp files from the Strix agent database: transient, not evidence.
docs/intern/strix-runs*/*/.state/*.db-shm
docs/intern/strix-runs*/*/.state/*.db-wal

# Strix live run output at repo root (working dir; archived evidence lives under docs/intern/)
/strix_runs/
