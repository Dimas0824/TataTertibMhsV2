# Example test environment — copy to `tests/.env.testing` to isolate tests from the app DB.
# Jika file ini tidak ada, suite otomatis fallback ke `.env` (root project).
#
# Salin: cp tests/.env.testing.example tests/.env.testing
# Lalu sesuaikan (test DB terpisah dianjurkan):
APP_ENV=testing
APP_BASE_PATH="auto"
APP_DEBUG=false

DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=disciplink_test;charset=utf8mb4"
DB_USER="root"
DB_PASS=""
