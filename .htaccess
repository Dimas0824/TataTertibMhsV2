DirectoryIndex index.php index.html

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- hardening: deny code/data/config paths outright ---
    # public news images must stay reachable (rendered via <img>) — allow BEFORE storage deny:
    RewriteRule ^storage/uploads/news/ - [L]
    RewriteRule ^(views|request|controllers|models|helpers|database|docs|document|tests|storage)(/|$) - [F,L,NC]

    # dotfiles (.env, .git, ...) — except .well-known (TLS-ALPN/ACME):
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F]

    # sensitive extensions served raw would leak creds/keys/schema/docs:
    RewriteRule \.(env|key|pem|crt|p12|sql|log|ini|bak|old|save|swp|dist|lock|zip|tar|tgz|gz|bz2|7z|rar|sh|bash|ps1|bat|cmd|py|pl|rb|md)$ - [F,L,NC]

    # never execute config/bootstrap files directly — every request goes through router.php:
    RewriteRule ^config\.php$ - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^index\.php$ router.php [L,QSA]

    RewriteRule ^$ router.php [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^(p|a)/[^/]+/?$ router.php [L,QSA]
    RewriteRule ^ router.php [L,QSA]
</IfModule>

# Gunakan path relatif agar tidak terkunci nama subfolder deploy tertentu.
ErrorDocument 400 errors/400.php
ErrorDocument 403 errors/403.php
ErrorDocument 404 errors/404.php
ErrorDocument 500 errors/500.php
ErrorDocument 503 errors/503.php

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header unset X-Powered-By
    Header unset X-Server
    <FilesMatch "\.(ico|jpg|jpeg|png|webp|svg|css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
